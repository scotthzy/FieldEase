.booking-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f7f6;
  color: #183b30;
}

.navigation {
  flex-shrink: 0;
  background-color: #ffffff;
  border-bottom: 1px solid #e5ebe7;
}

.navigation-row {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding-left: 20px;
}

.navigation-title {
  font-size: 18px;
  font-weight: 600;
  line-height: 26px;
}

/* The scroll view fills only the space below the navigation bar. */
.booking-content {
  flex: 1;
  height: 0;
  min-height: 0;
}

.booking-form {
  padding: 24px 20px;
  padding-bottom: calc(24px + env(safe-area-inset-bottom));
}

.form-field {
  margin-bottom: 24px;
}

.field-label {
  display: block;
  margin-bottom: 12px;
  font-size: 14px;
  line-height: 22px;
}

.picker-field {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 48px;
  padding: 12px 16px;
  border: 1px solid #d6e1da;
  border-radius: 8px;
  background-color: #ffffff;
  font-size: 16px;
  line-height: 24px;
}

.submit-button {
  box-sizing: border-box;
  width: 100%;
  margin: 0;
  padding: 12px 16px;
  border-radius: 8px;
  background-color: #183b30;
  color: #ffffff;
  font-size: 16px;
  font-weight: 600;
  line-height: 24px;
}

.submit-button-hover {
  background-color: #285344;
}
